# ── LLM Configuration ─────────────────────────────────────────────────────────
# Which LLM provider to use. One of: anthropic | openai | google
# Default: anthropic
LLM_PROVIDER=anthropic

# Model name override. Leave blank to use the provider's recommended default.
# Examples: claude-haiku-4-5, gpt-4o-mini, gemini-1.5-flash
LLM_MODEL=

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required when LLM_PROVIDER=openai (install extra: pip install ".[openai]")
OPENAI_API_KEY=

# Required when LLM_PROVIDER=google (install extra: pip install ".[google]")
GOOGLE_API_KEY=

# ── Discogs API ────────────────────────────────────────────────────────────────
# Personal access token from https://www.discogs.com/settings/developers
DISCOGS_API_TOKEN=

# ── Spotify Web API ────────────────────────────────────────────────────────────
# Register an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the redirect URI configured in the Spotify app dashboard exactly.
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# ── Spotify Local Files ────────────────────────────────────────────────────────
# Absolute path to the folder Spotify is configured to scan for local files.
# Spotify settings → Local Files → Add a source → point to this directory.
# Example (Windows): C:\Users\YourName\Music\Local
# Example (macOS):   /Users/YourName/Music/Local
LOCAL_FILES_DIRECTORY=

# Spotify playlist ID for the Local Bridge playlist.
# Find it in the playlist's share link: open.spotify.com/playlist/<ID>
LOCAL_BRIDGE_PLAYLIST_ID=

# ── Pipeline Tuning ────────────────────────────────────────────────────────────
# Minimum Confidence Score (0.0–1.0) a Candidate must reach to be considered
# viable. Candidates below this threshold cause the pipeline to loop back to
# search_candidates with an adjusted query.
# Default: 0.7
CONFIDENCE_THRESHOLD=0.7

# ── External Binary Dependencies ───────────────────────────────────────────────
# ffmpeg is required for audio post-processing by yt-dlp but is NOT a pip
# package. Install it separately and ensure it is on your system PATH.
#
#   Windows (winget): winget install Gyan.FFmpeg
#   Windows (choco):  choco install ffmpeg
#   macOS (brew):     brew install ffmpeg
#   Ubuntu/Debian:    sudo apt install ffmpeg
#
# This variable is a documentation placeholder — it is not read by the app.
FFMPEG_BINARY=ffmpeg
